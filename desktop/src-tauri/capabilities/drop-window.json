{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "drop-window",
  "description": "The Wildbloom Drop window: events, native menus, file dialogs and the clipboard",
  "windows": ["drop"],
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:webview:allow-get-all-webviews",
    "core:menu:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text"
  ]
}
